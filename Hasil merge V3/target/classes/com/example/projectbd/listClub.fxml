<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="700.0" prefWidth="700.0" styleClass="dashboard-anggota-content-area" stylesheets="@listClub.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectbd.ANGGOTA.listClubController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="14.0" layoutY="14.0" prefHeight="672.0" prefWidth="672.0" spacing="15.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
            <children>
                <Label styleClass="dashboard-anggota-content-label" text="List Club">
                    <font>
                        <Font name="System Bold" size="40.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="dashboard-anggota-content-label" text="Keyword Search">
                            <font>
                                <Font size="17.0" />
                            </font></Label>
                        <TextField fx:id="keywordSearchField" promptText="Enter keyword" styleClass="text-field" HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="17.0" />
                            </font></TextField>
                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#onSearchButtonClick" prefHeight="42.0" prefWidth="105.0" styleClass="dashboard-anggota-menu-button" text="Search">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets left="20.0" right="20.0" />
                    </VBox.margin>
                </HBox>

                <TableView fx:id="clubTableView" styleClass="table-view-custom" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idKategoriColumn" prefWidth="100.0" text="ID Kategori" />
                        <TableColumn fx:id="namaClubColumn" prefWidth="150.0" text="Nama Club" />
                        <TableColumn fx:id="deskripsiColumn" minWidth="0.0" prefWidth="168.800048828125" text="Deskripsi" />
                        <TableColumn fx:id="tahunBerdiriColumn" prefWidth="112.79996337890623" text="Tahun Berdiri" />
                    </columns>
                </TableView>

                <!-- Tombol untuk mendaftar ke club -->
                <HBox alignment="CENTER_RIGHT" prefWidth="200.0">
                    <children>
                        <Button fx:id="btnDaftarClub" mnemonicParsing="false" onAction="#onDaftarButtonClick" prefHeight="42.0" prefWidth="200.0" styleClass="dashboard-anggota-menu-button" text="Daftar ke Club">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets right="20.0" />
                    </padding>
                </HBox>

                <Label styleClass="dashboard-anggota-content-label" text="Club yang Anda Ikuti:">
                    <font>
                        <Font size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>

                <!-- Tabel untuk menampilkan club yang diikuti anggota -->
                <TableView fx:id="clubDiikutiTableView" prefHeight="150.0" styleClass="table-view-custom" VBox.vgrow="NEVER">
                    <columns>
                        <TableColumn fx:id="idKategoriDiikutiColumn" prefWidth="100.0" text="ID Kategori" />
                        <TableColumn fx:id="namaClubDiikutiColumn" prefWidth="150.0" text="Nama Club" />
                        <TableColumn fx:id="deskripsiDiikutiColumn" prefWidth="168.800048828125" text="Deskripsi" />
                        <TableColumn fx:id="tahunBerdiriDiikutiColumn" prefWidth="112.79996337890623" text="Tahun Berdiri" />
                    </columns>
                </TableView>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
