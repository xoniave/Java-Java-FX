<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="25.0" styleClass="content-view-container" stylesheets="@profile.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectbd.ANGGOTA.profileController"
      fx:id="contentArea"> <padding>
    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
</padding>
    <children>
        <Label styleClass="content-view-title" text="My Profile">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Label>

        <VBox styleClass="profile-details-card" alignment="TOP_CENTER">
            <GridPane hgap="20.0" vgap="18.0" alignment="CENTER" maxWidth="600.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="150.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" prefWidth="350.0" />
                </columnConstraints>
                <children>
                    <Label styleClass="profile-label" text="NRP:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="memberIdLabel" styleClass="profile-value" text="[Loading...]" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="profile-label" text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="nameLabel" styleClass="profile-value" text="[Loading...]" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="profile-label" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="emailLabel" styleClass="profile-value" text="[Loading...]" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="profile-label" text="Phone Number:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="phoneLabel" styleClass="profile-value" text="[Loading...]" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label styleClass="profile-label" text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <Label fx:id="addressLabel" styleClass="profile-value" text="[Loading...]" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                </children>
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
            </GridPane>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
        </HBox>
    </children>
</VBox>