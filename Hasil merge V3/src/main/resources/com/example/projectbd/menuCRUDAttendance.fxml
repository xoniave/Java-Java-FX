<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectbd.PENGURUS.menuCRUDAttendanceController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="10.0" layoutY="10.0" prefHeight="680.0" prefWidth="980.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
            <children>
                <!-- Search Bar -->
                <HBox alignment="CENTER_LEFT" prefHeight="54.0" prefWidth="960.0" spacing="10.0">
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                    <children>
                        <TextField fx:id="searchBar" prefHeight="36.0" prefWidth="879.0" promptText="Cari nama mahasiswa atau kegiatan..." />
                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch" text="Search" />
                    </children>
                </HBox>

                <!-- Table View -->
                <TableView fx:id="attendanceCrudTable" prefHeight="160.0" prefWidth="980.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdPartisipasi" prefWidth="80.0" text="ID Partisipasi" />
                        <TableColumn fx:id="colNrpMahasiswa" prefWidth="100.0" text="NRP" />
                        <TableColumn fx:id="colNamaMahasiswa" prefWidth="150.0" text="Nama Mahasiswa" />
                        <TableColumn fx:id="colNamaKegiatan" prefWidth="122.0" text="Nama Kegiatan" />
                        <TableColumn fx:id="colTanggalKegiatan" prefWidth="123.0" text="Tanggal Kegiatan" />
                        <TableColumn fx:id="colStatusKehadiran" prefWidth="120.0" text="Status Kehadiran" />
                        <TableColumn fx:id="colStatusSertifikat" prefWidth="120.0" text="Status Sertifikat" />
                        <TableColumn fx:id="colNomorSertifikat" prefWidth="150.0" text="Nomor Sertifikat" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </TableView>

                <!-- Form Update -->
                <VBox alignment="CENTER_LEFT" prefHeight="327.0" prefWidth="960.0" spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </VBox.margin>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="ID Partisipasi:" />
                                <TextField fx:id="fieldIdPartisipasi" editable="false" prefHeight="25.0" prefWidth="811.0" promptText="Otomatis terisi" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefHeight="17.0" prefWidth="120.0" text="Mahasiswa:" />
                                <!-- PERBAIKAN fx:id dari fieldNamaMahasiswa1 menjadi fieldNamaMahasiswa -->
                                <TextField fx:id="fieldNamaMahasiswa" editable="false" prefWidth="811.0" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Nama Kegiatan:" />
                                <TextField fx:id="fieldNamaKegiatan" editable="false" prefWidth="811.0" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefHeight="17.0" prefWidth="120.0" text="Tgl Kegiatan:" />
                                <!-- PERBAIKAN fx:id dari fieldTanggalKegiatan1 menjadi fieldTanggalKegiatan -->
                                <TextField fx:id="fieldTanggalKegiatan" editable="false" prefWidth="811.0" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Status Kehadiran:" />
                                <ComboBox fx:id="comboStatusKehadiran" prefWidth="811.0" promptText="Pilih Status" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Sertifikat (Dapat?):" />
                                <!-- PERBAIKAN fx:id dari comboDapatSertifikatKegiatan1 menjadi comboDapatSertifikatKegiatan -->
                                <ComboBox fx:id="comboDapatSertifikatKegiatan" prefWidth="811.0" promptText="Ya/Tidak" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Status Sertifikat:" />
                                <ComboBox fx:id="comboStatusSertifikat" prefWidth="811.0" promptText="Pilih Status" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Nomor Sertifikat:" />
                                <!-- PERBAIKAN fx:id dari fieldNomorSertifikat1 menjadi fieldNomorSertifikat -->
                                <TextField fx:id="fieldNomorSertifikat" prefWidth="811.0" promptText="Isi jika Tersedia" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnUpdate" onAction="#handleUpdate" prefHeight="25.0" prefWidth="72.0" text="Update" />
                                <Button fx:id="btnClear" onAction="#handleClear" prefHeight="25.0" prefWidth="72.0" text="Clear" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
