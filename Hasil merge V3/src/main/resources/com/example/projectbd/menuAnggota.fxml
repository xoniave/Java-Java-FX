<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="dashboard-anggota-root" stylesheets="@anggota.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectbd.ANGGOTA.menuAnggotaController">
    <left>
        <VBox prefHeight="600.0" prefWidth="252.0" styleClass="dashboard-anggota-sidebar" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="TOP_LEFT" spacing="5.0">
                    <children>
                        <Label fx:id="welcomeLabel" styleClass="dashboard-anggota-welcome-text" text="WELCOME..."> <font>
                            <Font name="System Bold" size="24.0" /> </font>
                        </Label>
                        <Label fx:id="memberNameLabel" styleClass="dashboard-anggota-member-name-label" text="[NAMA ANGGOTA]">
                            <font>
                                <Font name="System Bold" size="18.0" /> </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" left="20.0" right="10.0" top="30.0" />
                    </VBox.margin>
                </VBox>

                <Line endX="150.0" startX="0.0" stroke="#b0b0b0" strokeWidth="1.0"> <VBox.margin>
                    <Insets bottom="20.0" left="20.0" right="20.0" />
                </VBox.margin>
                </Line>

                <VBox alignment="TOP_LEFT" spacing="10.0">
                    <children>
                        <Button fx:id="profileButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onProfileClick" prefHeight="40.0" styleClass="dashboard-anggota-menu-button" text="Profile" />
                        <Button fx:id="listClubButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onListClubClick" prefHeight="40.0" styleClass="dashboard-anggota-menu-button" text="List Club" />
                        <Button fx:id="ActivityRegistrationButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onActivityRegistrationClick" prefHeight="40.0" styleClass="dashboard-anggota-menu-button" text="Activity Registration" />
                        <Button fx:id="activityAttendanceButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onActivityAttendanceClick" prefHeight="40.0" styleClass="dashboard-anggota-menu-button" text="Activity Attendance" /> </children>
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                </VBox>

                <Region VBox.vgrow="ALWAYS" /> <Button fx:id="logoutButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLogoutClick" prefHeight="40.0" styleClass="dashboard-anggota-logout-button" text="Logout">
                <VBox.margin>
                    <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
                </VBox.margin>
            </Button>
            </children>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER">
                    <children>
                        <Label styleClass="dashboard-anggota-content-label" text="Welcome to your Dashboard Content!">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Label styleClass="dashboard-anggota-content-label" text="This area will display information for each menu item">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
